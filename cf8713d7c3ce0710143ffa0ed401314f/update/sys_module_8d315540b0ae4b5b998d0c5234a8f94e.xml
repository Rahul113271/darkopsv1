        <content><![CDATA[// Runs on a 15-minute repeat schedule so ops leadership always has a near-real-time
// PulseScore per store rather than a once-a-day rollup, enabling live intervention.
(function () {
    var calculator = new x_2145749_qc.PulseScoreCalculator();
    var processed = calculator.calculateForAllActiveStores();
    gs.info('x_2145749_qc: PulseScore recalculated for ' + processed + ' active dark stores');
})();
]]></content>
