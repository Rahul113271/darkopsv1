        <description>Runs FraudDetectionEngine rule checks (repeat claim, velocity, timestamp mismatch, high-value-new-customer) and records the resulting risk score/flag.</description>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
