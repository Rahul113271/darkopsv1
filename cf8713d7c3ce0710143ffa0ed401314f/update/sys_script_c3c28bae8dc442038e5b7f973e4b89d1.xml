        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function evaluateFraudRisk(current, previous) {
    var engine = new x_2145749_qc.FraudDetectionEngine();
    var result = engine.evaluate(current);

    current.setValue('fraud_risk_score', result.riskScore);
    current.setValue('fraud_flagged', result.flagged);
    current.update();

    if (result.flagged) {
        var caseGr = new GlideRecord('sn_customerservice_case');
        if (caseGr.get(current.getValue('case'))) {
            caseGr.setValue('x_2145749_qc_fraud_review_required', true);
            caseGr.update();
        }
    }
})(current, previous);
]]></script>
